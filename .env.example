# Configuración del modelo LLM (Ollama / Gemma)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b   # ajustar según el tag exacto disponible en Ollama
OLLAMA_EMBEDDING_MODEL=bge-m3

# Vector store (Chroma) y chunking
CHROMA_PERSIST_DIR=data/chroma_db
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Configuración de la app
APP_PORT=8000

# Reranking (opcional: Cross-Encoder en 2da etapa; requiere requirements-reranker.txt)
ENABLE_RERANKER=false
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_INITIAL_K=15
RERANKER_TOP_K=6

# Interfaz UX/UI (Streamlit) — URL base de la API del agente
API_BASE_URL=http://localhost:8000
