# Configuración del modelo LLM (Ollama / Gemma)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b   # ajustar según el tag exacto disponible en Ollama
OLLAMA_EMBEDDING_MODEL=bge-m3

# Vector store (Chroma) y chunking
CHROMA_PERSIST_DIR=data/chroma_db
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Configuración de la app
APP_PORT=8000
